{
  "name": "@pi-plugins/claude-cli",
  "version": "0.3.0",
  "description": "Use a Claude subscription in pi by running each model request through the Claude Code CLI.",
  "keywords": [
    "anthropic",
    "claude",
    "claude-code",
    "pi",
    "pi-agent",
    "pi-extension",
    "pi-package",
    "provider"
  ],
  "homepage": "https://github.com/k3dom/pi-plugins/tree/main/plugins/claude-cli#readme",
  "bugs": {
    "url": "https://github.com/k3dom/pi-plugins/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k3dom/pi-plugins.git",
    "directory": "plugins/claude-cli"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "tsdown",
    "check": "pnpm run lint && pnpm run check-types && pnpm run format:check && pnpm run test",
    "check-types": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@effect/platform-node": "4.1.1",
    "@effect/vitest": "4.1.1",
    "@pi-plugins/fmt": "workspace:*",
    "@pi-plugins/lint": "workspace:*",
    "@pi-plugins/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "effect": "4.1.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./dist/index.mjs"
    ]
  }
}
