{
  "name": "@pi-plugins/websearch",
  "version": "0.2.1",
  "description": "WebSearch tool extension for pi-agent.",
  "keywords": [
    "pi",
    "pi-agent",
    "pi-extension",
    "pi-package",
    "websearch"
  ],
  "homepage": "https://github.com/k3dom/pi-plugins/tree/main/plugins/websearch#readme",
  "bugs": {
    "url": "https://github.com/k3dom/pi-plugins/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k3dom/pi-plugins.git",
    "directory": "plugins/websearch"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "tsdown",
    "check": "pnpm run lint && pnpm run check-types && pnpm run format:check",
    "check-types": "tsc -b",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@pi-plugins/fmt": "workspace:*",
    "@pi-plugins/lint": "workspace:*",
    "@pi-plugins/shared": "workspace:*",
    "@pi-plugins/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "effect": "4.1.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tsdown": "0.23.4",
    "typebox": "1.4.3",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./dist/index.mjs"
    ]
  }
}
