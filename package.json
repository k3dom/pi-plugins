{
  "name": "pi-plugins",
  "private": true,
  "workspaces": [
    "plugins/*",
    "tooling/*"
  ],
  "type": "module",
  "scripts": {
    "check": "turbo run check",
    "format": "oxfmt --disable-nested-config",
    "format:check": "oxfmt --disable-nested-config --check",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@pi-plugins/fmt": "workspace:*",
    "oxfmt": "0.75.0",
    "turbo": "2.11.10"
  },
  "packageManager": "pnpm@11.20.0"
}
