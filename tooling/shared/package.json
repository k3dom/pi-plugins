{
  "name": "@pi-plugins/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared utilities for pi-plugins extensions.",
  "type": "module",
  "exports": {
    "./config": "./src/config.ts",
    "./run": "./src/run.ts",
    "./statusline": "./src/statusline.ts",
    "./ui": "./src/ui.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "pnpm run lint && pnpm run check-types && pnpm run format:check",
    "check-types": "tsc -b",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@effect/platform-node": "4.1.2",
    "@pi-plugins/fmt": "workspace:*",
    "@pi-plugins/lint": "workspace:*",
    "@pi-plugins/tsconfig": "workspace:*",
    "effect": "4.1.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@effect/platform-node": "*",
    "effect": "*"
  }
}
