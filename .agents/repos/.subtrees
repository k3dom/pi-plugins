# Registry of git subtrees under .agents/repos/.
# Managed by scripts/add-subtree.sh and scripts/update-subtree.sh.
# Format: <prefix>\t<url>\t<ref>
#
# The ref pins each vendored repo to the release we depend on, so the reference
# material matches the versions in package.json. Bump it together with the
# dependency.
.agents/repos/pi	https://github.com/earendil-works/pi	v0.86.0
.agents/repos/effect	https://github.com/Effect-TS/effect	effect@4.0.0-rc.115
